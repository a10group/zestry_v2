// Zestry — Prisma Schema (FINAL, Phase 1 & 2)
// Auth: Clerk handles credentials/session; Prisma is the source of truth for role and plan/tier.
// Stock and credit balances are derived from append-only ledgers (StockMovement, CreditLedgerEntry)
// with cached aggregates updated only inside the same transaction as the ledger insert.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  CASHIER
}

enum Plan {
  FREE
  STARTER
  GROWTH
  BUSINESS
}

enum PlanStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum BillingProvider {
  MOBILE_MONEY
  CARD
  MANUAL // e.g. admin-granted, cash collected offline
}

enum PaymentMethod {
  CASH
  ORANGE_MONEY
  BANK
  CARD
}

enum SaleStatus {
  COMPLETED
  VOID
  REFUNDED
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  DAMAGE
  RETURN
  PURCHASE_ORDER_RECEIPT
}

enum CreditLedgerEntryType {
  SALE_ON_CREDIT
  PAYMENT
  ADJUSTMENT
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum NotificationType {
  SALE
  LOW_STOCK
  DEBT
  PAYMENT
  SYSTEM
  BILLING
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Vertical {
  RESTAURANT
  RETAIL
}

enum BusinessStatus {
  ONBOARDING // created, setup not finished
  ACTIVE
  ARCHIVED // abandoned or closed; kept for audit, hidden from the hub
}

// Where to resume an interrupted onboarding.
enum OnboardingStep {
  BUSINESS_INFO
  LOCATION_BRANDING_TAX
  PRODUCT_SETUP
}

enum IdentityProvider {
  CLERK
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

// ---------------------------------------------------------------------------
// Tenant / Auth / Billing (Phase 1)
// ---------------------------------------------------------------------------

model Business {
  id           String  @id @default(cuid())
  name         String
  logoUrl      String?
  phone        String?
  currency     String  @default("SLL")
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  taxInclusive Boolean @default(true)

  vertical Vertical

  status                BusinessStatus
  onboardingStep        OnboardingStep? // null once onboarding is complete
  onboardingCompletedAt DateTime?
  archivedAt            DateTime?

  country  String? // ISO 3166-1 alpha-2, for example "SL"
  timeZone String? // IANA name, for example "Africa/Freetown"
  address  String?
  email    String? // business contact email, not a login email

  taxConfiguredAt DateTime?

  plan             Plan       @default(FREE)
  planStatus       PlanStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  billedAmount     Decimal?   @db.Decimal(12, 2)
  billedCurrency   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products          Product[]
  customers         Customer[]
  sales             Sale[]
  stockMovements    StockMovement[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  suppliers         Supplier[]
  notifications     Notification[]
  invites           TeamInvite[]
  subscriptions     Subscription[]

  sites           Site[]
  memberships     Membership[]
  roleAssignments RoleAssignment[]

  @@index([status, updatedAt])
  @@map("businesses")
}

model Subscription {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        Plan
  status      PlanStatus
  provider    BillingProvider
  providerRef String? // mobile money txn id / moime subscription id
  amount      Decimal         @db.Decimal(12, 2)
  currency    String
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime        @default(now())

  @@index([businessId])
  @@map("subscriptions")
}

model User {
  id String @id @default(cuid())

  firstName    String?
  lastName     String?
  otherNames   String?
  phone        String? @unique // store normalised E.164, for example +23276123456
  contactPhone String? // given at sign-up, not verified; never used for sign-in or recovery

  email String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesAsCashier   Sale[]          @relation("SaleCashier")
  stockMovements   StockMovement[] @relation("StockMovementCreatedBy")
  expensesRecorded Expense[]       @relation("ExpenseCreatedBy")

  externalIdentities ExternalIdentity[]
  memberships        Membership[]

  @@map("users")
}

model TeamInvite {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email       String
  role        Role
  status      InviteStatus @default(PENDING)
  invitedAt   DateTime     @default(now())
  respondedAt DateTime?

  @@index([businessId])
  @@map("team_invites")
}

// ---------------------------------------------------------------------------
// Products & Inventory (Phase 1) — event-sourced stock
// ---------------------------------------------------------------------------

model Product {
  id                String   @id @default(cuid())
  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name              String
  sku               String?
  category          String?
  imageUrl          String?
  price             Decimal  @db.Decimal(12, 2)
  cost              Decimal? @db.Decimal(12, 2)
  currentStock      Int      @default(0) // cached aggregate
  lowStockThreshold Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants       ProductVariant[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  poItems        PurchaseOrderItem[]

  @@index([businessId])
  @@index([businessId, sku])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  sku           String?
  priceOverride Decimal? @db.Decimal(12, 2)
  currentStock  Int      @default(0) // cached aggregate
  createdAt     DateTime @default(now())

  stockMovements StockMovement[]
  saleItems      SaleItem[]

  @@index([productId])
  @@map("product_variants")
}

model StockMovement {
  id              String            @id @default(cuid())
  businessId      String
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant?   @relation(fields: [variantId], references: [id])
  type            StockMovementType
  quantityDelta   Int
  reason          String?
  saleId          String?
  sale            Sale?             @relation(fields: [saleId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  createdById     String
  createdBy       User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())

  @@index([businessId, productId])
  @@index([saleId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Customers & Credit (Phase 1 — Starter tier and above)
// ---------------------------------------------------------------------------

model Customer {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  notes         String?
  creditLimit   Decimal? @db.Decimal(12, 2)
  creditBalance Decimal  @default(0) @db.Decimal(12, 2) // cached aggregate
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales               Sale[]
  creditLedgerEntries CreditLedgerEntry[]

  @@index([businessId])
  @@map("customers")
}

model CreditLedgerEntry {
  id         String                @id @default(cuid())
  customerId String
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       CreditLedgerEntryType
  amount     Decimal               @db.Decimal(12, 2) // + increases debt, - reduces it
  saleId     String?
  sale       Sale?                 @relation(fields: [saleId], references: [id])
  method     PaymentMethod?
  notes      String?
  createdAt  DateTime              @default(now())

  @@index([customerId])
  @@map("credit_ledger_entries")
}

// ---------------------------------------------------------------------------
// POS / Sales (Phase 1)
// ---------------------------------------------------------------------------

model Sale {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?  @relation(fields: [customerId], references: [id])
  cashierId  String
  cashier    User       @relation("SaleCashier", fields: [cashierId], references: [id])
  subtotal   Decimal    @db.Decimal(12, 2)
  taxAmount  Decimal    @default(0) @db.Decimal(12, 2)
  total      Decimal    @db.Decimal(12, 2)
  status     SaleStatus @default(COMPLETED)
  isOnCredit Boolean    @default(false)
  createdAt  DateTime   @default(now())

  items               SaleItem[]
  payments            Payment[]
  stockMovements      StockMovement[]
  creditLedgerEntries CreditLedgerEntry[]

  @@index([businessId, createdAt])
  @@index([customerId])
  @@map("sales")
}

model SaleItem {
  id        String          @id @default(cuid())
  saleId    String
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Decimal         @db.Decimal(12, 2)
  unitCost  Decimal?        @db.Decimal(12, 2)

  @@index([saleId])
  @@map("sale_items")
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  @@index([saleId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Expenses (Phase 2 — Growth tier)
// ---------------------------------------------------------------------------

model ExpenseCategory {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String

  expenses Expense[]

  @@index([businessId])
  @@map("expense_categories")
}

model Expense {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amount      Decimal          @db.Decimal(12, 2)
  date        DateTime
  receiptUrl  String?
  notes       String?
  createdById String
  createdBy   User             @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([businessId, date])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Suppliers & Purchase Orders (Phase 2 — Growth tier)
// ---------------------------------------------------------------------------

model Supplier {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  contactName String?
  phone       String?
  email       String?
  createdAt   DateTime @default(now())

  purchaseOrders PurchaseOrder[]
  payments       SupplierPayment[]

  @@index([businessId])
  @@map("suppliers")
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  status     PurchaseOrderStatus @default(DRAFT)
  orderedAt  DateTime            @default(now())
  expectedAt DateTime?
  notes      String?

  items          PurchaseOrderItem[]
  stockMovements StockMovement[]
  payments       SupplierPayment[]

  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model SupplierPayment {
  id              String         @id @default(cuid())
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  amount          Decimal        @db.Decimal(12, 2)
  method          PaymentMethod
  paidAt          DateTime       @default(now())
  notes           String?

  @@index([supplierId])
  @@map("supplier_payments")
}

// ---------------------------------------------------------------------------
// Notifications (Phase 2 — Growth tier)
// ---------------------------------------------------------------------------

model Notification {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       NotificationType
  message    String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@index([businessId, read])
  @@map("notifications")
}

model Site {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roleAssignments RoleAssignment[]

  @@unique([businessId, name])
  @@map("sites")
}

model ExternalIdentity {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  IdentityProvider
  subject   String // the provider's user ID (for Clerk, the Clerk user ID)
  createdAt DateTime         @default(now())

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("external_identities")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status         MembershipStatus @default(ACTIVE)
  displayName    String // business-specific name
  employeeNumber String?
  disabledAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  roleAssignments RoleAssignment[]

  @@unique([userId, businessId])
  @@index([businessId, status])
  @@index([userId, status]) // the Business Hub query
  @@map("memberships")
}

model RoleAssignment {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  siteId       String? // null = whole business
  site         Site?      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  roleKey      String
  createdAt    DateTime   @default(now())

  @@index([membershipId])
  @@index([businessId, siteId])
  @@map("role_assignments")
}
